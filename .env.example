# Spectra OrderFlow POC settings. Every value is optional: the app runs with none of them set.
# Copy to .env to change a value.

# Database: a SQLite file on a laptop. On AWS it is RDS for MySQL (see the AWS block at the end and docs/AWS_DEPLOY.md).
# DATABASE_URL="file:./storage/orderflow.db"

# Folders (relative to the project root).
# NAVISION_DIR="data/navision"
# INBOX_DIR="data/inbox"
# STORAGE_DIR="storage"

# Address used inside approval links written to the Outbox.
# APP_BASE_URL="http://localhost:3000"

# Secret that signs SPR approval links. Change it outside local demos.
# APPROVAL_LINK_SECRET="local-demo-secret-change-me"

# Document extractor: "default" (no keys needed) or "llm" (calls the Anthropic API, falls back to default).
# EXTRACTOR="default"
# ANTHROPIC_API_KEY=""
# LLM_MODEL="claude-opus-5-5"

# Story 3: show sell price and margin on the SPR. Off by default (depends on data Spectra may not provide).
# SHOW_MARGIN="false"

# Story 5: a required shipping document that is still missing raises an alert this many hours before its due date.
# DOCUMENT_ALERT_WINDOW_HOURS="48"

# Story 6: an order that is still not ready raises a ship-date alert this many days before its promised ship date.
# SHIP_DATE_ALERT_DAYS="2"

# ---------------------------------------------------------------------------------------------------------------
# AWS (docs/AWS_DEPLOY.md). Leave all of these unset on a laptop. On the AWS server, infra/ec2/setup.sh writes them.
# AWS keys NEVER go here: the AWS SDK finds them itself (the server's IAM role, or `aws configure` on a laptop).
# AWS_REGION="ap-southeast-1"
# STORAGE_BACKEND="s3"                         # "local" (default) or "s3"
# S3_BUCKET="the DocumentBucketName output"
# NOTIFIER="ses"                               # "outbox" (default) or "ses": also email every sent message
# SES_FROM_ADDRESS="verified-sender@example.com"
# SES_TEST_RECIPIENT="your-inbox@example.com"  # every email goes here instead (sample addresses are made up)
# DATABASE_URL="mysql://user:password@host:3306/orderflow?sslaccept=strict&sslcert=/path/to/rds-global-bundle.pem"
# DATABASE_SSL="true"                          # TLS with the certificate checked (RDS)
# JOBS_SECRET="at least 16 characters"         # switches on POST /api/jobs/run for EventBridge Scheduler
