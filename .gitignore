# editor and assistant settings
.claude/
.vscode/

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (re-created by `npm install`)
/src/generated/

# pdf.js worker copied from node_modules by `npm install`
/public/pdf.worker.min.mjs

# runtime state: SQLite database and uploaded PDFs (re-created by `npm run seed`)
/storage/

# files the app writes for "Navision" (re-created by approving exports)
/data/navision/export/*
!/data/navision/export/.gitkeep

# KPI replay output
/reports/
