{
  "name": "spectra-orderflow-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Spectra OrderFlow proof of concept (SCCCI x NYP AI Innovation Challenge 26S2, PS11). Synthetic sample data only.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/make-mysql-schema.mjs && prisma generate && prisma generate --config prisma.mysql.config.ts && node scripts/copy-pdf-worker.mjs",
    "generate-data": "tsx scripts/generate-sample-data.ts",
    "seed": "tsx scripts/seed.ts --regenerate-data",
    "reset-demo": "tsx scripts/seed.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:golden": "tsx scripts/run-golden.ts",
    "test:e2e": "playwright test",
    "e2e:server": "tsx scripts/e2e-prepare.ts && tsx scripts/seed.ts && next build && next start -p 3217",
    "replay": "tsx scripts/replay.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/client-sesv2": "^3.1177.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^12.11.1",
    "decimal.js": "^10.6.0",
    "fuse.js": "^7.5.0",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
