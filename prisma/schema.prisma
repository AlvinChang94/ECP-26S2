// What: the database tables of the OrderFlow POC (SQLite now, RDS MySQL later).
// Who calls it: `prisma generate` (typed client in src/generated/prisma) and `prisma migrate` (SQL in prisma/migrations).
// To extend: add a model or field, then run `npx prisma migrate dev --name what_changed`. See docs/DEVELOPER_GUIDE.md.
//
// Rules that keep this schema portable to MySQL:
//  - Money is a decimal STRING ("12.40"), never Float. Code uses decimal.js (src/domain/money.ts).
//  - No enums and no Json type: plain String columns, checked by Zod and TypeScript unions in src/domain.
//  - No @default(now()) and no @updatedAt: every timestamp comes from the Clock adapter.
//  - Fields marked "LONG TEXT" need @db.Text (or @db.LongText) when the provider becomes mysql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// One PDF that entered the system (Inbox import or manual upload).
model Document {
  id                 String    @id @default(cuid())
  fileKey            String // where the PDF bytes live in the FileStore
  fileName           String
  sha256             String // fingerprint of the bytes, used to spot the same file arriving twice
  channel            String // upload | email | whatsapp (email and WhatsApp are simulated by the Inbox)
  sender             String?
  receivedAt         DateTime
  receivedBy         String
  detectedType       String // the extractor's guess, or "unknown"
  detectedConfidence Int // 0 to 100
  detectedReasons    String? // LONG TEXT. Why the extractor chose this type, one sentence per line.
  typeStatus         String // detected (waiting for a person) | confirmed
  confirmedType      String?
  confirmedBy        String?
  confirmedAt        DateTime?
  extractorName      String
  fieldsJson         String // LONG TEXT. ExtractedField[] exactly as read from the PDF. Never edited.
  editsFromEventId   Int       @default(0) // field edits older than this audit event belong to an earlier type and no longer apply
  reference          String? // main reference number read from the document (PO, PI or order number)
  routedKind         String? // order | payment | shipment | filed
  routedId           String? // order number, PaymentProof id or shipment number
  createdAt          DateTime

  @@index([sha256])
  @@index([typeStatus])
  @@index([reference])
}

/// Who did what, when. Field edits and undos are audit events too:
/// the current value of a field is its extracted value plus the edits recorded here.
model AuditEvent {
  id         Int      @id @default(autoincrement())
  at         DateTime
  actorName  String
  actorRole  String // sales | product_manager | approver | finance | purchase | system
  action     String // see src/domain/audit.ts for the list
  entityType String // document | order | spr | payment | shipment | alias | outbox | system
  entityId   String
  orderNo    String? // set when the event belongs on an order's timeline
  field      String?
  oldValue   String? // LONG TEXT
  newValue   String? // LONG TEXT
  reason     String? // LONG TEXT
  summary    String // LONG TEXT. Plain sentence shown in timelines.

  @@index([entityType, entityId])
  @@index([orderNo])
}

/// One customer order, from the moment its PO is captured.
model Order {
  orderNo            String    @id // ORD-1042
  poNumber           String? // customer's PO number (cached from the current PO version for lists and search)
  customerName       String? // cached from the current PO version
  customerNo         String? // Navision customer number, known once matched or created
  status             String // open | cancelled (the dashboard status is derived in src/domain/order/status.ts)
  currentPoVersionId String?
  receivedAt         DateTime // when the first PO document arrived
  exportedAt         DateTime? // first time the order was written to the Navision export folder
  promisedShipDate   String? // YYYY-MM-DD, copied from the approved PO version
  paymentTerms       String // advance | credit
  currency           String?
  totalAmount        String? // decimal string, from the exported lines
  piNumber           String?
  piIssuedAt         DateTime?
  paymentConfirmedAt DateTime?
  paymentConfirmedBy String?
  paymentConfirmNote String? // LONG TEXT. Override reason when the proof did not match exactly.
  cancelledAt        DateTime?
  cancelledBy        String?
  cancelReason       String? // LONG TEXT
  createdAt          DateTime

  @@index([poNumber])
}

/// One captured customer PO document for an order. Revision 2 and later are amendments.
model PoVersion {
  id               String    @id @default(cuid())
  orderNo          String
  revision         Int
  kind             String // new | amendment | cancellation
  status           String // draft | exported | superseded | cancelled | void
  documentId       String    @unique
  previousId       String? // the version this one amends or cancels
  customerCardJson String? // LONG TEXT. New customer card proposed by a person when the customer is not in Navision.
  exportPath       String? // file written under data/navision/export
  exportHash       String?
  exportJson       String? // LONG TEXT. Exact content that was written.
  exportedAt       DateTime?
  exportedBy       String?
  createdAt        DateTime

  @@index([orderNo])
}

/// A person's decision about one flag: an override (accept the difference) or a resolution (record the outcome).
model FlagDecision {
  id          String   @id @default(cuid())
  entityType  String // document | shipment
  entityId    String
  kind        String // override | resolution
  flagCode    String
  field       String
  fingerprint String // identifies the exact finding (code + field + values), so a changed value needs a new decision
  reason      String // LONG TEXT
  byName      String
  byRole      String
  at          DateTime

  @@index([entityType, entityId])
}

/// Alias memory: "this part number means that one". Suggested, never applied automatically.
model PartAlias {
  id             String   @id @default(cuid())
  fromPartNo     String   @unique // as written on customer documents
  toItemNo       String // the Navision item number
  createdBy      String
  createdAt      DateTime
  timesConfirmed Int      @default(0)
}

/// Delivered quantity per part, for partial fulfilment.
model Delivery {
  id         String   @id @default(cuid())
  orderNo    String
  partNo     String
  quantity   Int
  note       String?
  recordedBy String
  recordedAt DateTime

  @@index([orderNo])
}

/// Sales Purchase Requisition raised by a product manager and decided by Janet (or her stand-in).
model Spr {
  sprNo           String    @id // SPR-0007
  status          String // Draft | Submitted | Approved | Rejected
  partNo          String
  description     String
  vendorId        String
  vendorName      String
  unitPrice       String // decimal string, filled from Navision
  currency        String
  quantity        Int
  reason          String // LONG TEXT
  sellPrice       String? // only used when SHOW_MARGIN is on
  sourceOrderNo   String? // the customer order whose shortage triggered this SPR
  requestedBy     String
  createdAt       DateTime
  submittedAt     DateTime?
  assignedTo      String? // who must decide right now: Janet or her stand-in
  routingNote     String? // why it went to the stand-in (planned leave or 72 hours without a decision)
  escalatedAt     DateTime?
  decidedAt       DateTime?
  decidedBy       String?
  decisionRemarks String? // LONG TEXT
  evidenceJson    String? // LONG TEXT. Snapshot shown to the approver: stock, open orders, last price.

  @@index([status])
}

/// A signed, expiring, single-use approval link. Only the hash is stored; the link itself is in the Outbox message.
model ApprovalToken {
  id        String    @id @default(cuid())
  sprNo     String
  recipient String
  tokenHash String    @unique
  issuedAt  DateTime
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  @@index([sprNo])
}

/// Work to do at a later time (stand-in for EventBridge Scheduler). Run by runDueJobs(now).
model ScheduledJob {
  id          String    @id @default(cuid())
  type        String // spr_reminder | spr_escalation
  dueAt       DateTime
  status      String // pending | done | cancelled
  entityType  String
  entityId    String
  payloadJson String // LONG TEXT
  createdAt   DateTime
  ranAt       DateTime?

  @@index([status, dueAt])
  @@index([entityType, entityId])
}

/// Every notification the system produced (stand-in for SES email and SNS messages). Nothing leaves the machine.
model OutboxMessage {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime
  channel    String // email | chat
  type       String // see src/domain/notifications.ts for the list
  toName     String
  toAddress  String
  subject    String
  body       String // LONG TEXT
  status     String // draft (a person must review and click Send) | sent
  sentAt     DateTime?
  sentBy     String?
  entityType String?
  entityId   String?
  orderNo    String?
  dedupeKey  String?   @unique // set for reminders so the same one is never written twice

  @@index([type])
  @@index([orderNo])
}

/// A proof-of-payment document and the order it was matched to.
model PaymentProof {
  id            String   @id @default(cuid())
  documentId    String   @unique
  orderNo       String?
  matchResult   String // exact | short | over | no_match
  linkedBy      String? // Finance person who linked it by hand; null when the reference rule matched it
  duplicateOfId String?
  createdAt     DateTime

  @@index([orderNo])
}

/// A shipment whose documents and quantities we track: inbound (purchase) or outbound (sales).
model Shipment {
  shipmentNo   String    @id // SHP-0003
  direction    String // inbound | outbound
  reference    String // vendor PO number (inbound) or order number (outbound)
  partyName    String // vendor or customer
  orderNo      String? // the customer order this shipment serves
  dueDate      DateTime? // when the required documents are due
  assigneeName String?
  createdAt    DateTime

  @@unique([direction, reference])
  @@index([orderNo])
}

/// Links a confirmed document to a shipment.
model ShipmentDocument {
  id         String   @id @default(cuid())
  shipmentNo String
  documentId String   @unique
  docType    String
  createdAt  DateTime

  @@index([shipmentNo])
}

/// Small key-value settings, for example the demo clock offset.
model AppSetting {
  key   String @id
  value String
}

/// Running numbers for ORD, SPR and SHP references.
model Counter {
  name  String @id
  value Int
}
